#!/bin/sh
# Use the GM's client checker and its generated assets/framework, without xcodebuild.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export CLANG_MODULE_CACHE_PATH="${CLANG_MODULE_CACHE_PATH:-$repo/local-scratch/module-cache}"
checker="${ALVR_TYPECHECK:-$repo/tools/typecheck-client.sh}"
exec sh "$checker" "$repo"
